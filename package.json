{
  "name": "world-guard",
  "private": true,
  "version": "0.1.0",
  "description": "World Guard — aperi planeta cu o navă (joc web pentru telefon)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "vite build && node scripts/build-sw.mjs",
    "build": "tsc --noEmit && npm run bundle",
    "check": "npm run typecheck && npm run test && npm run bundle",
    "preview": "vite preview",
    "smoke": "npm run bundle && node scripts/smoke.cjs",
    "single": "vite build --config vite.single.config.ts && node scripts/single-file.mjs",
    "icons": "node scripts/make-icons.cjs",
    "balance": "vite build --config vite.balance.config.ts && node dist-balance/table.js"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
